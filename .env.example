# ---------------------------------------------------------------
# Kairo configuration.  Copy this file to .env.local and fill in.
#   cp .env.example .env.local
# .env.local is gitignored - your keys never leave your machine.
# ---------------------------------------------------------------

# Which provider to talk to: anthropic | openai | groq | ollama
LLM_PROVIDER=anthropic

# Optional. Leave blank to use the provider's default model.
LLM_MODEL=

# Only the key for your chosen provider is needed.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Ollama runs locally and needs no key. Override the host if not default.
OLLAMA_BASE_URL=http://localhost:11434/v1

# Generation settings
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024

# Simple abuse guard: max requests per IP per minute
RATE_LIMIT_PER_MINUTE=20
