# ---------------------------------------------------------------
# Kairo configuration.
#   cp .env.example .env.local
#   ...fill in below...
#   npm run check          <- verifies your key actually works
#
# .env.local is gitignored. Your keys never leave your machine.
# ---------------------------------------------------------------

# Which provider to talk to: anthropic | openai | groq | ollama
LLM_PROVIDER=groq

# Optional. Blank = the provider's default model.
# Run `npm run check -- --models` to see what your key can call.
LLM_MODEL=

# --- Keys: you only need the one for your chosen provider --------
#
# groq       https://console.groq.com/keys
#            Free tier, no credit card. Key starts with gsk_
GROQ_API_KEY=
#
# anthropic  https://console.anthropic.com/settings/keys
#            Prepaid credits required. Key starts with sk-ant-
ANTHROPIC_API_KEY=
#
# openai     https://platform.openai.com/api-keys
#            Prepaid credits required. Key starts with sk-
OPENAI_API_KEY=
#
# ollama     https://ollama.com/download  - runs on your own machine,
#            no key and no cost. `ollama serve` + `ollama pull llama3.2`
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Generation settings -----------------------------------------
# 0 = near-deterministic, 1+ = more varied. Try both.
LLM_TEMPERATURE=0.7
# Caps the length (and cost) of a single reply.
LLM_MAX_TOKENS=1024

# Abuse guard: max requests per IP per minute.
RATE_LIMIT_PER_MINUTE=20
