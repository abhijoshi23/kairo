# ---------------------------------------------------------------
# Kairo configuration.
#   cp .env.example .env.local
#   ...fill in below...
#   npm run check          <- verifies your key actually works
#
# .env.local is gitignored. Your keys never leave your machine.
# ---------------------------------------------------------------

# --- Access control ----------------------------------------------------
# REQUIRED IN PRODUCTION. Without it a deployed Kairo refuses to serve
# anything, because an open LLM endpoint is a free API proxy billed to you.
# Use something long and random:  openssl rand -base64 24
# Changing it signs out every existing session.
APP_PASSPHRASE=

# Which provider to talk to: anthropic | openai | groq | ollama
LLM_PROVIDER=groq

# Optional. Blank = the provider's default model.
# Run `npm run check -- --models` to see what your key can call.
LLM_MODEL=

# --- Keys: you only need the one for your chosen provider --------
#
# groq       https://console.groq.com/keys
#            Has a free tier. Key starts with gsk_
GROQ_API_KEY=
#
# anthropic  https://console.anthropic.com/settings/keys
#            Prepaid credits required. Key starts with sk-ant-
ANTHROPIC_API_KEY=
#
# openai     https://platform.openai.com/api-keys
#            Prepaid credits required. Key starts with sk-
OPENAI_API_KEY=
#
# ollama     https://ollama.com/download  - runs on your own machine,
#            no key and no cost. `ollama serve` + `ollama pull llama3.2`
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Web search (optional) ---------------------------------------
# Lets Kairo look things up instead of guessing about current facts.
# Leave as "none" and the tool is not offered to the model at all.
#   tavily  https://app.tavily.com  - 1,000 free credits/month, built for LLMs
#   serper  https://serper.dev      - 2,500 free searches/month, Google results
# Note: Brave's free tier ended in Feb 2026.
SEARCH_PROVIDER=none
TAVILY_API_KEY=
SERPER_API_KEY=

# Only needed to point at a proxy or a local stub instead of the real API.
# TAVILY_BASE_URL=
# SERPER_BASE_URL=

# --- Generation settings -----------------------------------------
# 0 = near-deterministic, 1+ = more varied. Try both.
LLM_TEMPERATURE=0.7
# Caps the length (and cost) of a single reply.
LLM_MAX_TOKENS=1024

# Abuse guard: max requests per IP per minute.
RATE_LIMIT_PER_MINUTE=20

# --- Rate limiting backend (optional) -----------------------------
# Leave both blank and the limiter falls back to an in-memory counter -
# fine for one machine, meaningless across multiple serverless instances.
# Set these (a free database at https://upstash.com) to share one real
# counter across every instance instead. Same behaviour either way, just
# honest about scope.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Voice output (optional) --------------------------------------
# Only openai and groq can speak - Anthropic and Ollama have no TTS
# endpoint. Leave blank for each provider's default voice.
#   openai  alloy, ash, ballad, coral, echo, fable, nova, onyx, sage,
#           shimmer, verse, marin, cedar
#   groq    autumn, diana, hannah (default), austin, daniel, troy
TTS_VOICE=
